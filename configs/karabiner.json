{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Copy Chrome URL with Cmd+Shift+C only in Chrome",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.google\\.Chrome$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "osascript -e 'tell application \"Google Chrome\" to get URL of active tab of front window' | pbcopy" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Disable Cmd+M minimise shortcut",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "m",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "key_code": "vk_none" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "f18" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}